# Film Randomized — local configuration (root .env)
# Production values live in GCP Secret Manager / Cloud Run (see scripts/gcp-bootstrap.sh).

# Required
# TMDb API key (https://www.themoviedb.org/settings/api) — build-time, ends up in the public bundle
VITE_TMDB_API_KEY=your_tmdb_api_key_here
# Min 32 characters
JWT_SECRET=your_jwt_secret_here

# Optional — defaults shown
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/film_randomized

# Optional — features stay disabled if unset
# AI_GATEWAY_URL=
# AI_GATEWAY_KEY=
